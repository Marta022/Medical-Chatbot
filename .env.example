LLM_PROVIDER=openai
OPENAI_API_KEY=replace_with_openai_key
OPENAI_MODEL=gpt-5
OLLAMA_MODEL=gemma2:2b
OLLAMA_HOST=http://ollama:11434
QWEN_MODEL=qwen3.5

QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=medical_docs

LLM_TXT_PATH=llm.txt
GUARDRAIL_LLM_ENABLED=true
DEFAULT_TOP_K=3
RETRIEVAL_MIN_SCORE=0.2
RETRIEVAL_RERANK_ENABLED=true
RETRIEVAL_RERANK_TOP_K=12
KEYWORD_FALLBACK_ENABLED=true
KEYWORD_FALLBACK_MIN_SCORE=0.18
KEYWORD_FALLBACK_CANDIDATE_LIMIT=1500
EVAL_PASS_SCORE=0.7
EVAL_MAX_RETRIES=2
EVAL_PROVIDER_FALLBACK_ORDER=openai,ollama
CHUNKING_STRATEGY=section
SEMANTIC_USE_LLAMAINDEX=true
ALLOW_SEMANTIC_CHUNK_FALLBACK=false
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ALLOW_FALLBACK_EMBEDDINGS=false
CHUNK_MIN_CHARS=40
CHUNK_MIN_WORDS=8
LIST_CHUNK_MIN_WORDS=2

DATASET_JSON_PATH=data/dataset/disease_database.json
DATASET_CSV_PATH=data/dataset/dataset_sheet1.csv
TOC_PDF_PATH=data/dataset/DORIN-CURS_SEM2_searchable.pdf
TOC_PAGE_INDEX=1
TOC_EXPECTED_COLUMNS=2
TOC_PAGE_OFFSET=0
TOC_PAGE_VALIDATION_WINDOW=2
TOC_REQUIRE_TITLE_HINT=false
TOC_MIN_NATIVE_TEXT_CHARS=120
TOC_USE_PP_STRUCTURE_FALLBACK=true
TOC_OUTPUT_JSON_PATH=data/dataset/dorin_sem2_toc_sections.json
TOC_ENTRIES_OUTPUT_JSON_PATH=data/dataset/dorin_sem2_toc_entries.json

API_ENABLED=true
API_REQUIRE_KEY=false
API_KEY=
API_MAX_QUERY_CHARS=2000
API_MAX_MESSAGES=32
API_MAX_TOP_K=10

# Local audit storage for final chatbot interactions and returned chunk references.
INTERACTION_DB_ENABLED=true
INTERACTION_DB_PATH=data/app/interactions.db
